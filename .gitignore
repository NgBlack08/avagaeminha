# Credenciais e segredos — nunca versionar.
# O site é público (GitHub Pages), então qualquer arquivo commitado aqui
# fica acessível na internet.
*.pem
*.key
*.p12
.env
.env.*
*chave*
*credencial*
*secret*
*service-account*

# Sistema operacional / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Material de estudo baixado (fonte de consulta, nao faz parte do site).
# O deploy e publico: nada aqui deve ir ao repositorio.
material/

# Node: o projeto nao tem dependencias de runtime nem de build (os testes
# usam so o runner nativo `node --test`), mas um `npm install` acidental
# criaria estes aqui.
node_modules/
npm-debug.log*
